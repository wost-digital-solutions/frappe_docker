# ============================================================================
# Groundtruth — environment configuration
# Copy this file to `.env` and fill in the values. Everything has a safe
# default so the app boots and runs in DEMO mode with zero configuration.
# ============================================================================

# --- Core ---
APP_NAME=Groundtruth
# Public URL where the app is served (used for Stripe redirects & links)
PUBLIC_BASE_URL=http://localhost:8000
# Secret used to sign JWT session tokens. CHANGE THIS in production.
SECRET_KEY=change-me-to-a-long-random-string
# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# SQLite by default (zero setup). For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/groundtruth
DATABASE_URL=sqlite:///./groundtruth.db

# --- LLM extraction (optional) ---
# Leave BOTH blank to run in DEMO mode (heuristic extractor, no external calls).
# Set ONE of these + install requirements-llm.txt to enable real extraction.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Default model. Examples: gemini-3.5-flash, gemini-3.5-pro, gpt-4o-mini
DEFAULT_MODEL_ID=gemini-3.5-flash

# --- Stripe billing (optional) ---
# Leave blank to run without billing (all users get the Free plan, no checkout).
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Create Products+Prices in Stripe, then paste the recurring Price IDs here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Optional metered price for per-page overage (usage-based). Leave blank to disable.
STRIPE_PRICE_OVERAGE_METERED=
